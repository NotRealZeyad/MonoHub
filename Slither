-- Services
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Configuration
local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 50000 -- Drastically increased force for a visible effect
local ROTATION_FORCE = 100000
local RESPONSIVENESS = 50 -- How snappy the head movement is

-- Player Variables
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local rootPart = character:WaitForChild("HumanoidRootPart")

-- State
local hasTransformed = false

-- This is the main function that performs the transformation
local function transformIntoWorm()
    -- Prevent the function from running more than once
    if hasTransformed or humanoid.Health <= 0 then return end
    hasTransformed = true
    print("[Worm Script] Activation key pressed. Starting transformation...")

    -- STEP 1: Create a reliable, moving target for the head to follow.
    local camera = workspace.CurrentCamera
    local targetPart = Instance.new("Part")
    targetPart.Parent = camera
    targetPart.Size = Vector3.new(1, 1, 1)
    targetPart.Anchored = true
    targetPart.CanCollide = false
    target_part.Transparency = 1
    
    -- This loop ensures the target is always perfectly matched to the camera's position.
    RunService.RenderStepped:Connect(function()
        targetPart.CFrame = camera.CFrame
    end)
    print("[Worm Script] Camera target created.")

    -- STEP 2: Safely activate the Ragdoll state. This prevents death.
    humanoid.BreakJointsOnDeath = false
    humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)
    print("[Worm Script] Ragdoll state activated. Character is now limp.")
    task.wait(0.1) -- Allow physics state to settle

    -- STEP 3: Apply forces to control the head and lift the body.
    local head = character:WaitForChild("Head")
    
    -- Create attachments for the physics constraints.
    local headAttachment = Instance.new("Attachment", head)
    local targetAttachment = Instance.new("Attachment", targetPart)
    
    -- This constraint DRAGS the head to the target part's position.
    local alignPosition = Instance.new("AlignPosition", head)
    alignPosition.Attachment0 = headAttachment
    alignPosition.Attachment1 = targetAttachment
    alignPosition.MaxForce = MOVEMENT_FORCE
    alignPosition.Responsiveness = RESPONSIVENESS
    
    -- This constraint ROTATES the head to match the target part's orientation.
    local alignOrientation = Instance.new("AlignOrientation", head)
    alignOrientation.Attachment0 = headAttachment
    alignOrientation.Attachment1 = targetAttachment
    alignOrientation.MaxTorque = ROTATION_FORCE
    alignOrientation.Responsiveness = RESPONSIVENESS
    print("[Worm Script] Head controls attached.")

    -- STEP 4: Apply anti-gravity to all parts to make it float.
    local gravity = workspace.Gravity
    for _, part in pairs(character:GetDescendants()) do
        if part:IsA("BasePart") then
            local antiGravity = Instance.new("VectorForce", part)
            antiGravity.Attachment0 = part:FindFirstChildOfClass("Attachment") or Instance.new("Attachment", part)
            antiGravity.Force = Vector3.new(0, part:GetMass() * gravity, 0)
            antiGravity.RelativeTo = Enum.ActuatorRelativeTo.World
        end
    end
    print("[Worm Script] Anti-gravity enabled. Transformation complete!")
end

-- Listen for the key press to start everything
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    -- Ignore if typing in chat
    if gameProcessedEvent then return end
    
    if input.KeyCode == ACTIVATION_KEY then
        transformIntoWorm()
    end
end)

print("[Worm Script] Loaded. Press 'E' to transform.")
