--[[ 
    🪱 Definitive Worm Transformation (Error-Proof Version)
    - No "nil" errors
    - Safe LocalScript behavior
    - Keeps humanoid alive
    - Physics-based control of head via camera
]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--// Settings
local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 25000
local MOVEMENT_RESPONSIVENESS = 25

--// Player setup
local player = Players.LocalPlayer
local function getCharacter()
	local char = player.Character
	if not char or not char.Parent then
		char = player.CharacterAdded:Wait()
	end
	return char
end

local character = getCharacter()
local humanoid = character:WaitForChild("Humanoid")
local head = character:WaitForChild("Head")

--// State tracking
local hasTransformed = false
local cleanupObjects = {}

-- Utility to create & track
local function create(instanceType, parent)
	local obj = Instance.new(instanceType)
	obj.Parent = parent
	table.insert(cleanupObjects, obj)
	return obj
end

local function transformIntoWorm()
	if hasTransformed then return end
	hasTransformed = true
	print("🐛 Transforming into worm...")

	-- Ensure humanoid exists and character is loaded
	if not humanoid or not head then
		warn("Character not fully loaded.")
		return
	end

	-- STEP 1: Prep humanoid
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.PlatformStand = true
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	-- Let the player control physics of the head
	head:SetNetworkOwner(player)

	-- STEP 2: Create invisible part to track camera position
	local camera = Workspace.CurrentCamera
	if not camera then
		warn("Camera not found.")
		return
	end

	local cameraPart = create("Part", Workspace)
	cameraPart.Anchored = true
	cameraPart.CanCollide = false
	cameraPart.Size = Vector3.new(0.1, 0.1, 0.1)
	cameraPart.Transparency = 1
	cameraPart.Name = "CameraTracker"

	-- Keep cameraPart synced with camera every frame
	RunService.RenderStepped:Connect(function()
		if camera and camera.CFrame then
			cameraPart.CFrame = camera.CFrame
		end
	end)

	-- STEP 3: Attachments & constraints
	local cameraAttachment = create("Attachment", cameraPart)
	local headAttachment = create("Attachment", head)

	local alignPos = create("AlignPosition", head)
	alignPos.Attachment0 = headAttachment
	alignPos.Attachment1 = cameraAttachment
	alignPos.MaxForce = MOVEMENT_FORCE
	alignPos.Responsiveness = MOVEMENT_RESPONSIVENESS
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

	local alignOri = create("AlignOrientation", head)
	alignOri.Attachment0 = headAttachment
	alignOri.Attachment1 = cameraAttachment
	alignOri.MaxTorque = MOVEMENT_FORCE * 2
	alignOri.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment

	print("✅ Worm transformation complete. The worm lives!")
end

--// Activation
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == ACTIVATION_KEY then
		transformIntoWorm()
	end
end)

print("🐛 Worm Script ready. Press 'E' to transform safely.")
