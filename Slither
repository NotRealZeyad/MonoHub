--[[ 
    🪱 Worm Mode (Safe Toggle Version)
    - Press E to toggle on/off
    - No death or broken joints
    - Head follows camera smoothly
    - Keeps humanoid alive and controllable
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 15000
local MOVEMENT_RESPONSIVENESS = 20

local player = Players.LocalPlayer

-- Wait for character safely
local function getCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("Humanoid")
	char:WaitForChild("Head")
	return char
end

local character = getCharacter()
local humanoid = character:WaitForChild("Humanoid")
local head = character:WaitForChild("Head")

local isWorm = false
local cameraPart, cameraAttach, headAttach, alignPos, alignOri
local connections = {}

local function cleanup()
	for _, conn in ipairs(connections) do
		conn:Disconnect()
	end
	connections = {}

	if alignPos then alignPos:Destroy() end
	if alignOri then alignOri:Destroy() end
	if cameraAttach then cameraAttach:Destroy() end
	if headAttach then headAttach:Destroy() end
	if cameraPart then cameraPart:Destroy() end
end

local function toggleWorm()
	if not isWorm then
		isWorm = true
		print("🐛 Entering worm mode...")

		-- Keep humanoid active (no PlatformStand)
		humanoid.BreakJointsOnDeath = false
		humanoid.RequiresNeck = false

		-- Create invisible part to follow camera
		local cam = Workspace.CurrentCamera
		cameraPart = Instance.new("Part")
		cameraPart.Anchored = true
		cameraPart.CanCollide = false
		cameraPart.Transparency = 1
		cameraPart.Size = Vector3.new(0.1, 0.1, 0.1)
		cameraPart.Name = "CameraTracker"
		cameraPart.Parent = Workspace

		table.insert(connections, RunService.RenderStepped:Connect(function()
			cameraPart.CFrame = cam.CFrame
		end))

		cameraAttach = Instance.new("Attachment", cameraPart)
		headAttach = Instance.new("Attachment", head)

		alignPos = Instance.new("AlignPosition", head)
		alignPos.Attachment0 = headAttach
		alignPos.Attachment1 = cameraAttach
		alignPos.MaxForce = MOVEMENT_FORCE
		alignPos.Responsiveness = MOVEMENT_RESPONSIVENESS
		alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

		alignOri = Instance.new("AlignOrientation", head)
		alignOri.Attachment0 = headAttach
		alignOri.Attachment1 = cameraAttach
		alignOri.MaxTorque = MOVEMENT_FORCE * 2
		alignOri.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
		alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment

		print("✅ Worm mode ON! (Press E again to revert)")
	else
		isWorm = false
		print("🔄 Reverting to normal mode...")
		cleanup()
		print("✅ Back to normal.")
	end
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == ACTIVATION_KEY then
		toggleWorm()
	end
end)

print("🐍 Press 'E' to toggle Worm Mode safely.")
