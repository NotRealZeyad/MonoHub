-- Services
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

-- Configuration
local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 25000 -- The force used to move the head
local MOVEMENT_RESPONSIVENESS = 25 -- How quickly the head reacts

-- Player Variables
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")

-- State
local hasTransformed = false
local attachments = {} -- Keep track of created objects to clean up later

-- This is the main function that performs the transformation
local function transformIntoWorm()
    if hasTransformed then return end
    hasTransformed = true
    print("Initiating DEFINITIVE worm transformation...")

    -- STEP 1: PREPARE THE HUMANOID FOR RAGDOLL
    -- These properties tell the server that we are intentionally going limp.
    humanoid.BreakJointsOnDeath = false
    humanoid.RequiresNeck = false
    
    -- STEP 2: ACTIVATE THE OFFICIAL RAGDOLL STATE
    -- This is the key to the entire script. It makes the character floppy
    -- in a way the server understands and accepts, PREVENTING DEATH.
    humanoid:ChangeState(Enum.HumanoidStateType.Ragdoll)

    -- Give it a moment for the state change to register fully
    wait(0.1)

    -- STEP 3: SET UP HEAD CONTROLS
    -- Now that the body is limp, we will control the head and drag it around.
    local head = character:WaitForChild("Head")
    head.Size = Vector3.new(3, 3, 3) -- Make head easier to see

    -- Use modern AlignPosition/Orientation for smooth, physics-based control
    local camera = workspace.CurrentCamera
    
    -- Create an attachment point on the camera to follow
    local cameraAttachment = Instance.new("Attachment", camera.CFramePart)
    table.insert(attachments, cameraAttachment)
    
    -- Create an attachment point on our head
    local headAttachment = Instance.new("Attachment", head)
    table.insert(attachments, headAttachment)

    -- This constraint forces the head to the camera's position
    local alignPosition = Instance.new("AlignPosition", head)
    alignPosition.Attachment0 = headAttachment
    alignPosition.Attachment1 = cameraAttachment
    alignPosition.MaxForce = MOVEMENT_FORCE
    alignPosition.Responsiveness = MOVEMENT_RESPONSIVENESS
    table.insert(attachments, alignPosition)

    -- This constraint forces the head to match the camera's orientation
    local alignOrientation = Instance.new("AlignOrientation", head)
    alignOrientation.Attachment0 = headAttachment
    alignOrientation.Attachment1 = cameraAttachment
    alignOrientation.MaxTorque = MOVEMENT_FORCE * 2
    alignOrientation.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
    table.insert(attachments, alignOrientation)

    print("Transformation successful. The worm is alive!")
end

-- Listen for the key press to start everything
UserInputService.InputBegan:Connect(function(input, gameProcessedEvent)
    -- Ignore if typing in chat
    if gameProcessedEvent then return end
    
    if input.KeyCode == ACTIVATION_KEY then
        transformIntoWorm()
    end
end)

print("Definitive Worm Script loaded. Press 'E' to transform safely.")
