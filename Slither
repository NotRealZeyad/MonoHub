--[[ 
    🪱 Working Worm Transformation (Final Fixed Version)
    - No nil errors
    - No permanent freeze
    - No death
    - Head follows camera using physics
]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--// Settings
local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 25000
local MOVEMENT_RESPONSIVENESS = 25

--// Player setup
local player = Players.LocalPlayer

-- Wait for character
local function waitForCharacter()
	local char = player.Character
	if not char or not char.Parent then
		char = player.CharacterAdded:Wait()
	end
	char:WaitForChild("Humanoid")
	char:WaitForChild("Head")
	return char
end

local character = waitForCharacter()
local humanoid = character:WaitForChild("Humanoid")
local head = character:WaitForChild("Head")

--// State tracking
local hasTransformed = false
local cleanupObjects = {}

-- Utility: make & track instances
local function make(what, parent)
	local inst = Instance.new(what)
	inst.Parent = parent
	table.insert(cleanupObjects, inst)
	return inst
end

--// Worm Transform
local function transformIntoWorm()
	if hasTransformed then return end
	hasTransformed = true
	print("🐛 Transforming...")

	-- Safe humanoid prep
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	-- Allow local control of head physics
	head:SetNetworkOwner(player)

	-- Create invisible part to follow camera
	local cam = Workspace.CurrentCamera
	if not cam then
		warn("Camera not ready.")
		return
	end

	local cameraPart = make("Part", Workspace)
	cameraPart.Anchored = true
	cameraPart.CanCollide = false
	cameraPart.Transparency = 1
	cameraPart.Size = Vector3.new(0.1, 0.1, 0.1)
	cameraPart.Name = "CameraTracker"

	-- Keep part synced with camera
	RunService.RenderStepped:Connect(function()
		if cam and cam.CFrame then
			cameraPart.CFrame = cam.CFrame
		end
	end)

	-- Create attachments + constraints
	local cameraAttach = make("Attachment", cameraPart)
	local headAttach = make("Attachment", head)

	local alignPos = make("AlignPosition", head)
	alignPos.Attachment0 = headAttach
	alignPos.Attachment1 = cameraAttach
	alignPos.MaxForce = MOVEMENT_FORCE
	alignPos.Responsiveness = MOVEMENT_RESPONSIVENESS
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

	local alignOri = make("AlignOrientation", head)
	alignOri.Attachment0 = headAttach
	alignOri.Attachment1 = cameraAttach
	alignOri.MaxTorque = MOVEMENT_FORCE * 2
	alignOri.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment

	print("✅ Worm mode active!")
end

--// Keybind
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == ACTIVATION_KEY then
		transformIntoWorm()
	end
end)

print("🐍 Press 'E' to become a worm!")
