--[[ 
    🪱 Worm Transformation (Client-Safe Final Version)
    - Works fully as a LocalScript in StarterPlayerScripts
    - No server-only API calls
    - No nil or transparency errors
    - Keeps character alive
    - Camera-controlled head physics
]]

local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 25000
local MOVEMENT_RESPONSIVENESS = 25

local player = Players.LocalPlayer

local function waitForCharacter()
	local char = player.Character or player.CharacterAdded:Wait()
	char:WaitForChild("Humanoid")
	char:WaitForChild("Head")
	return char
end

local character = waitForCharacter()
local humanoid = character:WaitForChild("Humanoid")
local head = character:WaitForChild("Head")

local hasTransformed = false
local created = {}

local function make(class, parent)
	local inst = Instance.new(class)
	inst.Parent = parent
	table.insert(created, inst)
	return inst
end

local function transformIntoWorm()
	if hasTransformed then return end
	hasTransformed = true
	print("🐛 Transforming into worm...")

	-- Prep humanoid (no full physics state)
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.PlatformStand = true  -- allows flop but stays alive

	-- Create invisible camera tracker
	local cam = Workspace.CurrentCamera
	local cameraPart = make("Part", Workspace)
	cameraPart.Anchored = true
	cameraPart.CanCollide = false
	cameraPart.Transparency = 1
	cameraPart.Size = Vector3.new(0.1, 0.1, 0.1)
	cameraPart.Name = "CameraTracker"

	RunService.RenderStepped:Connect(function()
		if cam and cam.CFrame then
			cameraPart.CFrame = cam.CFrame
		end
	end)

	-- Attachments & constraints
	local camAttach = make("Attachment", cameraPart)
	local headAttach = make("Attachment", head)

	local alignPos = make("AlignPosition", head)
	alignPos.Attachment0 = headAttach
	alignPos.Attachment1 = camAttach
	alignPos.MaxForce = MOVEMENT_FORCE
	alignPos.Responsiveness = MOVEMENT_RESPONSIVENESS
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

	local alignOri = make("AlignOrientation", head)
	alignOri.Attachment0 = headAttach
	alignOri.Attachment1 = camAttach
	alignOri.MaxTorque = MOVEMENT_FORCE * 2
	alignOri.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment

	print("✅ Worm mode active! (Head follows camera)")
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end
	if input.KeyCode == ACTIVATION_KEY then
		transformIntoWorm()
	end
end)

print("🐍 Press 'E' to become a worm!")
