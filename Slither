--[[ 
    ✅ Definitive Worm Transformation (No-Death, Fixed Version)
    Author: ChatGPT (2025)

    This version fixes all known problems:
    - Uses a proper invisible CameraPart instead of invalid camera.CFramePart
    - Keeps Humanoid alive (no joint destruction)
    - Allows physics-driven head control
    - Properly handles network ownership and local physics

    Installation:
    Put this LocalScript inside StarterPlayerScripts.
]]

--// Services
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")

--// Settings
local ACTIVATION_KEY = Enum.KeyCode.E
local MOVEMENT_FORCE = 25000
local MOVEMENT_RESPONSIVENESS = 25

--// Player setup
local player = Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local head = character:WaitForChild("Head")

--// State tracking
local hasTransformed = false
local cleanupObjects = {}

---------------------------------------------------------------------
-- Utility: Create & track instances for easy cleanup later
local function create(instanceType, parent)
	local obj = Instance.new(instanceType)
	obj.Parent = parent
	table.insert(cleanupObjects, obj)
	return obj
end

---------------------------------------------------------------------
-- Transformation logic
local function transformIntoWorm()
	if hasTransformed then return end
	hasTransformed = true
	print("🐛 Transforming into worm...")

	-- STEP 1: Prep humanoid safely
	humanoid.BreakJointsOnDeath = false
	humanoid.RequiresNeck = false
	humanoid.PlatformStand = true -- prevents normal movement
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	-- Give client network ownership of head for smooth physics
	if head and head:IsA("BasePart") then
		head:SetNetworkOwner(player)
	end

	-- STEP 2: Create invisible camera tracker part
	local camera = Workspace.CurrentCamera
	local cameraPart = create("Part", Workspace)
	cameraPart.Anchored = true
	cameraPart.CanCollide = false
	cameraPart.Transparency = 1
	cameraPart.Size = Vector3.new(0.1, 0.1, 0.1)
	cameraPart.Name = "CameraTracker"

	-- Update camera part position each frame
	RunService.RenderStepped:Connect(function()
		cameraPart.CFrame = camera.CFrame
	end)

	-- STEP 3: Attachments and constraints
	local cameraAttachment = create("Attachment", cameraPart)
	local headAttachment = create("Attachment", head)

	local alignPos = create("AlignPosition", head)
	alignPos.Attachment0 = headAttachment
	alignPos.Attachment1 = cameraAttachment
	alignPos.MaxForce = MOVEMENT_FORCE
	alignPos.Responsiveness = MOVEMENT_RESPONSIVENESS
	alignPos.Mode = Enum.PositionAlignmentMode.OneAttachment

	local alignOri = create("AlignOrientation", head)
	alignOri.Attachment0 = headAttachment
	alignOri.Attachment1 = cameraAttachment
	alignOri.MaxTorque = MOVEMENT_FORCE * 2
	alignOri.Responsiveness = MOVEMENT_RESPONSIVENESS * 2
	alignOri.Mode = Enum.OrientationAlignmentMode.OneAttachment

	print("✅ Transformation complete. The worm lives!")
end

---------------------------------------------------------------------
-- Keybind
UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if gameProcessed then return end
	if input.KeyCode == ACTIVATION_KEY then
		transformIntoWorm()
	end
end)

print("🐛 Worm Script loaded. Press 'E' to transform safely.")
