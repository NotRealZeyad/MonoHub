-- THE PAYLOAD: The chaos unleashed upon infection.
-------------------------------------------------------------------------------------
local function ThePayload(character)
    if not character or not character:FindFirstChild("HumanoidRootPart") then return end
    local fling = Instance.new("BodyVelocity", character.HumanoidRootPart)
    fling.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    fling.Velocity = Vector3.new(math.random(-150, 150), math.random(75, 175), math.random(-150, 150))
    game:GetService("Debris"):AddItem(fling, 0.25)
end

